लग्नं","iast":"udayalagnaṃ","source":"MWE"},{"slp1":"rASicakraM","word":"राशिचक्रं","iast":"rāśicakraṃ","source":"AE"},{"slp1":"dvandvaH","word":"द्वन्द्वः","iast":"dvandvaḥ","source":"MWE"},{"slp1":"uttaragolaH","word":"उत्तरगोलः","iast":"uttaragolaḥ","source":"MWE"},{"slp1":"astalagnaM","word":"अस्तलग्नं","iast":"astalagnaṃ","source":"MWE"},{"slp1":"rASimaRqalaM","word":"राशिमण्डलं","iast":"rāśimaṇḍalaṃ","source":"MWE"},{"slp1":"karkawarASiH","word":"कर्कटराशिः","iast":"karkaṭarāśiḥ","source":"MWE"},{"slp1":"AraRyarASiH","word":"आरण्यराशिः","iast":"āraṇyarāśiḥ","source":"MWE"},{"slp1":"kumBarASiH","word":"कुम्भराशिः","iast":"kumbharāśiḥ","source":"MWE"},{"slp1":"dakziRagolaH","word":"दक्षिणगोलः","iast":"dakṣiṇagolaḥ","source":"MWE"},{"slp1":"rASikuRqalI","word":"राशिकुण्डली","iast":"rāśikuṇḍalī","source":"MWE"},{"slp1":"jyotizcakraM","word":"ज्योतिष्चक्रं","iast":"jyotiṣcakraṃ","source":"AE"},{"slp1":"jyotiScakraM","word":"ज्योतिश्चक्रं","iast":"jyotiścakraṃ","source":"MWE"},{"slp1":"jyotiScakram","word":"ज्योतिश्चक्रम्","iast":"jyotiścakram","source":"BOR"},{"slp1":"sUryyasaNkrAntiH","word":"सूर्य्यसङ्क्रान्तिः","iast":"sūryyasaṅkrāntiḥ","source":"MWE"},{"slp1":"meza-","word":"मेष-","iast":"meṣa-","source":"MWE"},{"slp1":"rASi-","word":"राशि-","iast":"rāśi-","source":"BOR"},{"slp1":"DanuH -nu","word":"धनुः -नु","iast":"dhanuḥ -nu","source":"MWE"}],"sources":["Apte Student's English-Sanskrit Dictionary (1920)","Borooah English-Sanskrit Dictionary (1877)","Monier-Williams English-Sanskrit Dictionary (1851)"],"details":[{"source":"Apte Student's English-Sanskrit Dictionary (1920)","body":"Zodiac, s. jyotizcakraM, BUcakraM, maMqalaM, rASicakraM; ‘a sign of the z(odiac)’ rASiH, lagnaM."},{"source":"Borooah English-Sanskrit Dictionary (1877)","body":"ZODIAC: (1) jyotiScakram;(2) Bacakram;(3) rASi- cakram, sign of the z.: rASiH."},{"source":"Monier-Williams English-Sanskrit Dictionary (1851)","body":"ZODIAC , s. rASicakraM, jyotiScakraM, rASimaRqalaM, BacakraM, BamaRqalaM, BAganaM, rimPaM; ‘a sign of the zodiac,’ rASiH m., lagnaM, BaM; ‘the twelve signs collectively,’ rASigaRaH, BagaRaH, rASikuRqalI, meza- vfzAdayaH m. pl. These are, 1. Aries, mezaH; 2. Taurus, vfzaH, vfzaBaH; 3. Gemini, miTunaH, dvandvaH, jittamaH; 4. Cancer, karkawaH, karkaH, karkawarASiH m.; 5. Leo, siMhaH, AraRyarASiH m.; 6. Virgo, kanyA; 7. Libra, tulA, tulADAraH, DawaH; 8. Scorpio, vfScikaH, kOrpyaH, aliH m.; 9. Sagittarius, DanuH -nu m. n., tOkzikaH; 10. Capricornus, makaraH, makararASiH m.; 11. Aquarius, kumBaH, kumBarASiH m.; 12. Pisces, mInaH, mInarASiH m., mInalagnaM, JazaH. Of the twelve signs there are two divisions, one called uttaragolaH, consisting of the six signs, from Aries to Virgo, the other called dakziRagolaH, comprising the remaining six signs. ‘The rising of a sign,’ lagnaM, udayaH; ‘setting,’ astaM; ‘rising sign,’ udayalagnaM; ‘setting sign,’ astalagnaM; ‘circuit of the sun through the zodiac,’ BAganaM, BagaRaH; ‘passage of the sun through a sign,’ sUryyasaNkrAntiH f., ravisaNkrAntiH f., sUryya- saNkramaRaM; ‘of a planet,’ rASiBogaH; ‘passage of the sun or a planet from one sign into another,’ saNkrAntiH f., saNkramaH."}]},{"key":"zodiacal","sanskrit":[{"slp1":"BacakrasambanDI","word":"भचक्रसम्बन्धी","iast":"bhacakrasambandhī","source":"MWE"},{"slp1":"rASicakrasambanDI -nDinI","word":"राशिचक्रसम्बन्धी -न्धिनी","iast":"rāśicakrasambandhī -ndhinī","source":"MWE"}],"sources":["Monier-Williams English-Sanskrit Dictionary (1851)"],"details":[{"source":"Monier-Williams English-Sanskrit Dictionary (1851)","body":"ZODIACAL , a. rASicakrasambanDI -nDinI &c., BacakrasambanDI &c."}]},{"key":"zone","sanskrit":[{"slp1":"rasanA","word":"रसना","iast":"rasanā","source":"MWE"},{"slp1":"valayaH","word":"वलयः","iast":"valayaḥ","source":"MWE"},{"slp1":"meKalA","word":"मेखला","iast":"mekhalā","source":"AE"},{"slp1":"kAMcI","word":"कांची","iast":"kāṃcī","source":"AE"},{"slp1":"maMqalaM","word":"मंडलं","iast":"maṃḍalaṃ","source":"AE"},{"slp1":"kalApaH","word":"कलापः","iast":"kalāpaḥ","source":"MWE"},{"slp1":"raSa(sa)nA","word":"रश(स)ना","iast":"raśa(sa)nā","source":"AE"},{"slp1":"kawibaMDaH","word":"कटिबंधः","iast":"kaṭibaṃdhaḥ","source":"AE"},{"slp1":"maRqalam","word":"मण्डलम्","iast":"maṇḍalam","source":"BOR"},{"slp1":"BUmeKalA","word":"भूमेखला","iast":"bhūmekhalā","source":"MWE"},{"slp1":"*maRqalam","word":"*मण्डलम्","iast":"*maṇḍalam","source":"BOR"},{"slp1":"maDyadeSaH","word":"मध्यदेशः","iast":"madhyadeśaḥ","source":"MWE"},{"slp1":"SItamaRqalam","word":"शीतमण्डलम्","iast":"śītamaṇḍalam","source":"BOR"},{"slp1":"BUkawibanDaH","word":"भूकटिबन्धः","iast":"bhūkaṭibandhaḥ","source":"MWE"},{"slp1":"*Garma-","word":"*घर्म-","iast":"*gharma-","source":"BOR"},{"slp1":"krAnti-","word":"क्रान्ति-","iast":"krānti-","source":"MWE"},{"slp1":"BU-)valayaH-yaM","word":"भू-)वलयः-यं","iast":"bhū-)valayaḥ-yaṃ","source":"AE"},{"slp1":"BUvalayaH -yaM","word":"भूवलयः -यं","iast":"bhūvalayaḥ -yaṃ","source":"MWE"}],"sources":["Apte Student's English-Sanskrit Dictionary (1920)","Borooah English-Sanskrit Dictionary (1877)","Monier-Williams English-Sanskrit Dictionary (1851)"],"details":[{"source":"Apte Student's English-Sanskrit Dictionary (1920)","body":"Zone, s. meKalA, raSa(sa)nA, kAMcI; See Girdle. 2 maMqalaM, (BU-)valayaH-yaM, kawibaMDaH."},{"source":"Borooah English-Sanskrit Dictionary (1877)","body":"ZONE: I A girdle: q. v.: meKalA.II Of the earth: *maRqalam (?), torrid, frigid z.: *Garma- maRqalam, SItamaRqalam."},{"source":"Monier-Williams English-Sanskrit Dictionary (1851)","body":"ZONE , s. (Girdle) meKalA, rasanA, kalApaH, see GIRDLE. — (Of the earth) BUmeKalA, BUvalayaH -yaM, BUkawibanDaH; ‘torrid zone,’ krAnti- valayaH, maDyadeSaH."}]},{"key":"zoographer","sanskrit":[{"slp1":"prARivarRanakft","word":"प्राणिवर्णनकृत्","iast":"prāṇivarṇanakṛt","source":"MWE"},{"slp1":"paSvAdivivaraRakft","word":"पश्वादिविवरणकृत्","iast":"paśvādivivaraṇakṛt","source":"MWE"}],"sources":["Monier-Williams English-Sanskrit Dictionary (1851)"],"details"